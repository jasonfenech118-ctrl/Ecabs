# Vai Drive Claims — environment variables.
# Copy to `.env` and fill in for production. Never commit the real .env.
# (Django doesn't auto-load .env; export these or use your host's env settings.)

# --- Core ---------------------------------------------------------------------
DJANGO_DEBUG=0
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=yourdomain.example.com

# --- HTTPS / security (only apply when DJANGO_DEBUG=0) ------------------------
# Set to 0 only if a proxy/load balancer already forces HTTPS.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
# Comma-separated https origins Django should trust for CSRF, e.g.
# https://yourdomain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------------
# Leave DB_NAME unset to use SQLite. Set it (plus psycopg installed) for PostgreSQL.
# DB_NAME=vaidrive
# DB_USER=vaidrive
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Email (SMTP) -------------------------------------------------------------
# For Gmail, EMAIL_HOST_PASSWORD must be an app password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=motorclaims@ecabs.com.mt

# --- Google Drive (optional) --------------------------------------------------
# GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/service-account.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
